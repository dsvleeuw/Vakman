# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PRERENDER_SITE_URL: Canonical origin used for <link rel="canonical">,
# Open Graph URLs and sitemap.xml during `npm run build`.
PRERENDER_SITE_URL="https://klusbaas.nl"

# VITE_DEMO_PHONE: The Klusbaas number that call/WhatsApp buttons on demo
# sites (/voorbeeld/... and the wizard preview) route to. Leave empty to show
# a "Dit is een demo" notice instead. Never dials the sample sector numbers.
VITE_DEMO_PHONE=""

# --- Leads and quotes (POST /api/lead, GET /api/quote) ---
# Resend API key (https://resend.com/api-keys). Set it in Netlify, never in
# git. Without it the API runs in preview mode: nothing is sent and the mails
# are printed to the server log.
RESEND_API_KEY=""
# Sender. onboarding@resend.dev only delivers to the Resend account address;
# verify a domain in Resend to mail customers, then use e.g.
# "Klusbaas <offerte@klusbaas.nl>".
QUOTE_FROM_EMAIL="Klusbaas <onboarding@resend.dev>"
# Where every lead and quote (with PDF) is delivered.
QUOTE_NOTIFY_EMAIL="thomascliphero@gmail.com"
# Origin for quote links in e-mails. On Netlify it falls back to the built-in URL
# (production site), then the request origin. Leave empty in local dev to get localhost links.
PUBLIC_SITE_URL="https://vakmanschap.netlify.app"
# Testing without a verified domain: customer confirmations go here instead,
# with the intended address in the subject. Leave empty in production.
MAIL_TEST_RECIPIENT=""

# --- Het overzicht van Klusbaas (/klusbaas) ---
# Password for the overview with the requests, the offers and the published
# sites. Leave empty to keep the overview closed: without it there is no way
# in, and there is no default password.
ADMIN_PASSWORD=""

# --- Betaling (de klant betaalt voor zijn site) ---
# The IBAN the customer transfers the amount to. Without it the account shows
# no bank details and asks the customer to contact Klusbaas.
PAYMENT_IBAN=""
# The name of the account holder and the address for questions about the payment.
PAYMENT_NAME="Klusbaas"
PAYMENT_EMAIL=""

# --- Factuur (het document dat de klant krijgt als hij betaalt) ---
# Klusbaas' own details, printed on the invoice. Everything is optional:
# what is not set is not printed, so no KvK number is ever made up. Set
# these before sending an invoice to a business customer.
# The name the invoice is issued under (default: PAYMENT_NAME).
INVOICE_NAME=""
# The postal address.
INVOICE_ADDRESS=""
# The KvK number and the VAT number.
INVOICE_KVK=""
INVOICE_VAT=""
# The e-mail address for questions about the invoice (default: PAYMENT_EMAIL).
INVOICE_EMAIL=""

# --- Newsletter (POST /api/newsletter, double opt-in) ---
# Uses RESEND_API_KEY and QUOTE_FROM_EMAIL above. Optional Resend Audience id:
# confirmed subscribers are added there (and marked unsubscribed on /afmelden),
# so a Resend Broadcast can reach them. Leave empty to keep the list only in
# Netlify Blobs (store "newsletter").
RESEND_AUDIENCE_ID=""
