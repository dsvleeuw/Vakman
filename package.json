{
  "name": "react-example",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "check": "node scripts/check.mjs",
    "lint": "tsc --noEmit",
    "test": "bun test src",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "build:spa": "vite build",
    "lh:scan": "node scripts/lighthouse-scan.mjs",
    "lh:merge": "node scripts/lighthouse-scan.mjs --merge"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@netlify/blobs": "^11.1.6",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
